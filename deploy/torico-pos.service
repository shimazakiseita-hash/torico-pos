[Unit]
Description=TORI-CO POS (yakitori stall order app)
After=network.target

[Service]
Type=simple
# ↓ 2行を本番機のユーザー名とパスに書き換える
User=CHANGE_ME
WorkingDirectory=/home/CHANGE_ME/torico-pos
Environment=NODE_ENV=production
Environment=TZ=Asia/Tokyo
# nvm などで Node を入れた場合は npm の絶対パスに書き換え、下の PATH の行も有効にする（`which npm` で確認）
# PATH が無いと、npm から呼ばれる node が /usr/bin/node（OS の古い版）になることがある
#Environment=PATH=/home/CHANGE_ME/.nvm/versions/node/v24.x.x/bin:/usr/local/bin:/usr/bin:/bin
# npm run event：サーバー・お客さん向けページへの送信（.env.public があるとき）・10分ごとのバックアップをまとめて動かす
ExecStart=/usr/bin/npm run event
Restart=always
RestartSec=2
# 止めるときに最後のバックアップを取る時間
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
